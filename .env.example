# Leave role tokens unset for a LOOPBACK-ONLY demo session.
# Set distinct high-entropy tokens of at least 24 characters for authenticated mode.
# Generate each token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# AEGISWEAVE_ADMIN_TOKEN=
# AEGISWEAVE_ANALYST_TOKEN=
# AEGISWEAVE_VIEWER_TOKEN=
# CLI forwarding/replay token (analyst/admin). Never put it on a command line:
# AEGISWEAVE_TOKEN=
# This file is a template. The application reads environment variables, not .env automatically.
